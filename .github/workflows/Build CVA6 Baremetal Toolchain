name: Build CVA6 Baremetal Toolchain

on:
  workflow_dispatch:
    inputs:
      config:
        description: 'Toolchain config name (see util/toolchain-builder/config/)'
        required: true
        default: 'gcc-13.1.0-baremetal'

env:
  INSTALL_DIR: /opt/riscv

jobs:
  build:
    runs-on: ubuntu-22.04
    timeout-minutes: 360

    steps:
      - name: Free up disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          sudo docker image prune --all --force || true
          df -h /

      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            autoconf automake autotools-dev curl wget git cmake ninja-build \
            python3 python3-pip libmpc-dev libmpfr-dev libgmp-dev gawk \
            build-essential bison flex texinfo gperf libtool patchutils bc \
            zlib1g-dev libexpat-dev libglib2.0-dev device-tree-compiler \
            help2man rsync unzip

      - name: Prepare install directory
        run: |
          sudo mkdir -p "$INSTALL_DIR"
          sudo chown -R "$USER":"$USER" "$INSTALL_DIR"

      - name: Fetch toolchain sources
        working-directory: util/toolchain-builder
        run: sh get-toolchain.sh "${{ inputs.config }}"

      - name: Build and install toolchain
        working-directory: util/toolchain-builder
        env:
          NUM_JOBS: ${{ steps.cpus.outputs.n }}
        run: sh build-toolchain.sh "${{ inputs.config }}" "$INSTALL_DIR"

      - name: Sanity check
        run: |
          ls "$INSTALL_DIR/bin"
          "$INSTALL_DIR"/bin/riscv*-gcc --version | head -n 1

      - name: Package toolchain
        run: tar -czf riscv-toolchain.tar.gz -C "$(dirname "$INSTALL_DIR")" "$(basename "$INSTALL_DIR")"

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: cva6-${{ inputs.config }}
          path: riscv-toolchain.tar.gz
          retention-days: 30
